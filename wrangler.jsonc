{
  // Cloudflare Worker 설정: 앱 화면(dist) + /api 중계 서버를 한 주소로 제공
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-emoji-maker",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "observability": { "enabled": true }
  // 비밀 값(Cloudflare 대시보드 → 설정 → 변수 및 비밀에서 입력):
  //   GEMINI_API_KEY  : 사장님 Gemini API 키
  //   ADMIN_PASSWORD  : 관리자 화면 비밀번호
}
